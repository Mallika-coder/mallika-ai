# LLM Providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GROQ_API_KEY=gsk_your-groq-key
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=postgresql+asyncpg://mallika:mallika_secret@postgres:5432/mallika_ai
DATABASE_URL_SYNC=postgresql://mallika:mallika_secret@postgres:5432/mallika_ai

# Redis
REDIS_URL=redis://redis:6379/0

# Search APIs
TAVILY_API_KEY=tvly-your-tavily-key
SERPAPI_KEY=your-serpapi-key

# File Storage
UPLOAD_DIR=/app/data/uploads
MAX_FILE_SIZE_MB=50

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App Settings
APP_NAME=MallikaAI
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# Vector DB
CHROMA_PERSIST_DIR=/app/data/vectorstores
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Sandbox
SANDBOX_IMAGE=mallika-sandbox:latest
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=512m
